@model ServiceStationBillingWeb.Models.SupplyInvoiceFormViewModel
@{ ViewData["Title"] = "New Supply Invoice"; }
<div class="page-heading"><div><p class="eyebrow">Purchasing records</p><h1>New Supply Invoice</h1></div></div>
<section class="form-section"><form asp-action="Create" method="post" class="form-grid"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="InvoiceNo"></label><input asp-for="InvoiceNo" autofocus /><span asp-validation-for="InvoiceNo" class="validation"></span></div><div class="field"><label asp-for="SupplierCode"></label><input asp-for="SupplierCode" /><span asp-validation-for="SupplierCode" class="validation"></span></div><div class="field"><label asp-for="ItemId"></label><input asp-for="ItemId" /><span asp-validation-for="ItemId" class="validation"></span></div><div class="field"><label asp-for="BuyingPrice"></label><input asp-for="BuyingPrice" type="number" min="0.01" step="0.01" /></div><div class="field"><label asp-for="Quantity"></label><input asp-for="Quantity" type="number" min="0.01" step="0.01" /></div><div class="field"><label asp-for="PaymentStatus"></label><select asp-for="PaymentStatus"><option>Cash</option><option>Credit</option><option>Cheque</option></select></div><div class="field"><label asp-for="ChequeNo"></label><input asp-for="ChequeNo" /></div><div class="field"><label asp-for="BranchCode"></label><input asp-for="BranchCode" /></div><div class="field"><label asp-for="BankCode"></label><input asp-for="BankCode" /></div><div class="field"><label asp-for="ValueDate"></label><input asp-for="ValueDate" type="date" /></div><div class="form-actions"><button class="button button-primary" type="submit">Save supply invoice</button><a class="button button-quiet" asp-action="Index">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }