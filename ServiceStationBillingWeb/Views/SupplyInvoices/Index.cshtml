@model ServiceStationBillingWeb.Models.SupplyInvoiceListViewModel
@{ ViewData["Title"] = "Supply Invoices"; }
<div class="page-heading"><div><p class="eyebrow">Purchasing records</p><h1>Supply Invoices</h1></div>@if (User.IsInRole("Admin")) { <a class="button button-primary" asp-action="Create">New supply invoice</a> }</div>
@if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
<form method="get" class="toolbar"><input name="search" value="@Model.Search" placeholder="Search invoice, supplier or item" /><select name="paymentStatus"><option value="">All payment statuses</option><option selected="@(Model.PaymentStatus == "Cash")">Cash</option><option selected="@(Model.PaymentStatus == "Credit")">Credit</option><option selected="@(Model.PaymentStatus == "Cheque")">Cheque</option></select><button class="button button-secondary">Filter</button></form>
<form asp-action="Settle" method="post"><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="paymentStatus" value="@Model.PaymentStatus" /><section class="content-section"><div class="table-wrap"><table><thead><tr><th>Select</th><th>Invoice</th><th>Supplier</th><th>Item</th><th class="number">Qty</th><th class="number">Buying price</th><th class="number">Total</th><th>Payment</th><th>Created</th><th>Settlement</th></tr></thead><tbody>@foreach(var invoice in Model.Invoices){<tr><td><input type="checkbox" name="selectedIds" value="@invoice.Id" @(string.IsNullOrWhiteSpace(invoice.SettledAt) ? null : "disabled") /></td><td class="strong">@invoice.InvoiceNo</td><td>@invoice.SupplierCode</td><td>@invoice.ItemId</td><td class="number">@invoice.Quantity.ToString("N2")</td><td class="number">@invoice.BuyingPrice.ToString("N2")</td><td class="number">@invoice.Total.ToString("N2")</td><td>@invoice.PaymentStatus</td><td>@invoice.CreatedAt</td><td>@(string.IsNullOrWhiteSpace(invoice.SettledAt) ? "Unsettled" : invoice.SettledAt)</td></tr>}</tbody></table></div>@if(Model.Invoices.Count == 0){<div class="empty-state compact"><p>No supply invoices match this search.</p></div>} @if(User.IsInRole("Admin") && Model.Invoices.Any(i => string.IsNullOrWhiteSpace(i.SettledAt))){<button class="button button-primary" type="submit">Mark selected settled</button>} </section></form>