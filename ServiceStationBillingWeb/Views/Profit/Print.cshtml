@model ServiceStationBillingWeb.Models.ProfitStatementViewModel
<!doctype html><html><head><meta charset="utf-8" /><title>Profit Statement @Model.From to @Model.To</title><style>body{font:14px Arial;color:#222;margin:30px}h1{margin-bottom:4px}table{border-collapse:collapse;width:100%;margin-top:20px}th,td{border:1px solid #bbb;padding:7px;text-align:left}th{background:#eee}.number{text-align:right}.summary{display:flex;gap:24px;border:1px solid #bbb;padding:12px;margin-top:20px}</style></head><body onload="window.print()"><h1>ISURU Service Center</h1><p>Profit Statement: @Model.From to @Model.To</p><div class="summary"><span>Service: @Model.ServiceRevenue.ToString("N2")</span><span>Parts: @Model.PartsRevenue.ToString("N2")</span><span>COGS: @Model.Cogs.ToString("N2")</span><span>Gross: @Model.GrossProfit.ToString("N2")</span><span>Purchases: @Model.Purchases.ToString("N2")</span><strong>Net: @Model.NetProfit.ToString("N2")</strong></div><table><thead><tr><th>Date</th><th>Invoice</th><th>Description</th><th>Item ID</th><th>Qty</th><th>Revenue</th><th>Cost</th><th>Profit</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.Date</td><td>@line.InvoiceNo</td><td>@line.Description</td><td>@line.ItemId</td><td class="number">@line.Quantity.ToString("N2")</td><td class="number">@line.Revenue.ToString("N2")</td><td class="number">@line.Cost.ToString("N2")</td><td class="number">@line.Profit.ToString("N2")</td></tr>}</tbody></table></body></html>