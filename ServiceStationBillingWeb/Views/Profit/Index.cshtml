@model ServiceStationBillingWeb.Models.ProfitStatementViewModel
@{ ViewData["Title"] = "Profit Statement"; }
<div class="page-heading"><div><p class="eyebrow">Financial reporting</p><h1>Profit Statement</h1></div><a class="button button-secondary" target="_blank" asp-action="Print" asp-route-from="@Model.From" asp-route-to="@Model.To">Print report</a></div>
<form method="get" class="toolbar"><input type="date" name="from" value="@Model.From" /><input type="date" name="to" value="@Model.To" /><button class="button button-secondary" type="submit">Generate</button></form>
<div class="metric-grid"><article class="metric-card"><span>Service revenue</span><strong>@Model.ServiceRevenue.ToString("N2")</strong></article><article class="metric-card"><span>Parts revenue</span><strong>@Model.PartsRevenue.ToString("N2")</strong></article><article class="metric-card"><span>COGS</span><strong>@Model.Cogs.ToString("N2")</strong></article><article class="metric-card accent"><span>Gross profit</span><strong>@Model.GrossProfit.ToString("N2")</strong></article></div>
<section class="content-section"><div class="section-heading"><h2>Summary</h2></div><p>Total purchases: <strong>@Model.Purchases.ToString("N2")</strong> &nbsp; Net profit after purchases: <strong>@Model.NetProfit.ToString("N2")</strong></p><div class="table-wrap"><table><thead><tr><th>Date</th><th>Invoice</th><th>Description</th><th>Item ID</th><th class="number">Qty</th><th class="number">Revenue</th><th class="number">Cost</th><th class="number">Profit</th></tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td>@line.Date</td><td>@line.InvoiceNo</td><td>@line.Description</td><td>@line.ItemId</td><td class="number">@line.Quantity.ToString("N2")</td><td class="number">@line.Revenue.ToString("N2")</td><td class="number">@line.Cost.ToString("N2")</td><td class="number">@line.Profit.ToString("N2")</td></tr> }</tbody></table></div></section>