@model ServiceStationBillingWeb.Models.SettingsViewModel
@{ ViewData["Title"] = "Settings"; }
<div class="page-heading"><div><p class="eyebrow">Application configuration</p><h1>Settings</h1></div></div>
@if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
<section class="form-section"><form asp-action="Index" method="post" class="form-grid"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="AdminUsername"></label><input asp-for="AdminUsername" autocomplete="username" /><span asp-validation-for="AdminUsername" class="validation"></span></div><div class="field"><label asp-for="AdminPassword"></label><input asp-for="AdminPassword" autocomplete="new-password" /><span asp-validation-for="AdminPassword" class="validation"></span></div><div class="field"><label asp-for="UserUsername"></label><input asp-for="UserUsername" autocomplete="username" /><span asp-validation-for="UserUsername" class="validation"></span></div><div class="field"><label asp-for="UserPassword"></label><input asp-for="UserPassword" autocomplete="new-password" /><span asp-validation-for="UserPassword" class="validation"></span></div><div class="form-actions"><button class="button button-primary" type="submit">Save settings</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }