@model ServiceStationBillingWeb.Models.InventoryFormViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Edit inventory item" : "Add inventory item";
}
<div class="page-heading"><div><p class="eyebrow">Stock records</p><h1>@ViewData["Title"]</h1></div></div>
<section class="form-section"><form asp-action="@(editing ? "Edit" : "Create")" method="post" class="form-grid"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="ItemId"></label><input asp-for="ItemId" autofocus /><span asp-validation-for="ItemId" class="validation"></span></div><div class="field"><label asp-for="ItemName"></label><input asp-for="ItemName" /><span asp-validation-for="ItemName" class="validation"></span></div><div class="field"><label asp-for="Brand"></label><input asp-for="Brand" /><span asp-validation-for="Brand" class="validation"></span></div><div class="field"><label asp-for="Quantity"></label><input asp-for="Quantity" type="number" min="0" step="0.01" /><span asp-validation-for="Quantity" class="validation"></span></div><div class="field"><label asp-for="UnitPrice"></label><input asp-for="UnitPrice" type="number" min="0" step="0.01" /><span asp-validation-for="UnitPrice" class="validation"></span></div><div class="field"><label asp-for="BuyingPrice"></label><input asp-for="BuyingPrice" type="number" min="0" step="0.01" /><span asp-validation-for="BuyingPrice" class="validation"></span></div><div class="field"><label asp-for="SupplierCode"></label><input asp-for="SupplierCode" /><span asp-validation-for="SupplierCode" class="validation"></span></div><div class="field"><label asp-for="PaymentMethod"></label><select asp-for="PaymentMethod"><option>Cash</option><option>Credit</option><option>Cheque</option></select></div><div class="form-actions"><button class="button button-primary" type="submit">Save item</button><a class="button button-quiet" asp-action="Index">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }