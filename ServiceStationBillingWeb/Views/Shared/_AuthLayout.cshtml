<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ISURU Service Center</title>
    <link rel="stylesheet" href="/css/site.css?v=20260906" />
    <style>
        body.auth-page { margin: 0; min-height: 100vh; background: #f0f0f0; font: 14px "Segoe UI", Tahoma, sans-serif; }
        .auth-shell { min-height: 100vh; display: grid; place-items: center; }
        .auth-panel { width: 350px; min-height: 335px; padding: 20px; box-sizing: border-box; background: #fff; border: 1px solid #aaa; box-shadow: 0 2px 8px #999; }
        .auth-panel .brand-mark { color: #0d47a1; font: bold 20px "Segoe UI", sans-serif; }
        .auth-panel h1 { font: bold 16px "Segoe UI", sans-serif; margin: 14px 0 16px; }
        .auth-panel .eyebrow { color: #333; font-size: 14px; margin: 0 0 10px; letter-spacing: 0; text-transform: none; }
        .auth-panel .muted { margin-bottom: 15px; }
        .auth-presets { display: flex; gap: 8px; margin-bottom: 14px; }
        .auth-presets button, .auth-form button { min-height: 30px; padding: 4px 14px; border: 1px solid #888; background: #f5f5f5; font: 14px "Segoe UI", sans-serif; cursor: pointer; }
        .auth-form { display: grid; grid-template-columns: 80px 1fr; gap: 8px; align-items: center; margin: 0; }
        .auth-form input { width: 100%; min-height: 24px; box-sizing: border-box; padding: 2px 5px; border: 1px solid #888; }
        .auth-form label { font-weight: 400; }
        .auth-form .validation, .auth-form .button { grid-column: 2; }
        .auth-form .button { width: 100px; margin-top: 10px; }
    </style>
</head>
<body class="auth-page">
    <main class="auth-shell">@RenderBody()</main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>