@model ServiceStationBillingWeb.Models.SupplierListViewModel
@{ ViewData["Title"] = "Suppliers"; }
<div class="page-heading"><div><p class="eyebrow">Supplier records</p><h1>Suppliers</h1></div>@if (User.IsInRole("Admin")) { <a class="button button-primary" asp-action="Create">Add supplier</a> }</div>
@if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
<form method="get" class="toolbar"><input name="search" value="@Model.Search" placeholder="Search by code, name or contact" aria-label="Search suppliers" /><button class="button button-secondary" type="submit">Search</button>@if (!string.IsNullOrWhiteSpace(Model.Search)) { <a class="button button-quiet" asp-action="Index">Clear</a> }</form>
<section class="content-section"><div class="table-wrap"><table><thead><tr><th>Supplier code</th><th>Name</th><th>Contact</th><th class="number">Cash</th><th class="number">Credit</th><th class="number">Cheque</th><th>Invoice</th><th class="actions">Actions</th></tr></thead><tbody>
@foreach (var supplier in Model.Suppliers) { <tr><td>@supplier.SupplierCode</td><td class="strong">@supplier.Name</td><td>@supplier.Contact</td><td class="number">@supplier.CashTotal.ToString("N2")</td><td class="number">@supplier.CreditTotal.ToString("N2")</td><td class="number">@supplier.ChequeTotal.ToString("N2")</td><td><form asp-action="UpdateInvoice" method="post" class="inline-form"><input type="hidden" name="id" value="@supplier.SupplierCode" /><input type="hidden" name="search" value="@Model.Search" /><input name="invoice" value="@supplier.Invoice" aria-label="Invoice for @supplier.SupplierCode" onchange="this.form.submit()" /></form></td><td class="actions">@if (User.IsInRole("Admin")) { <a class="text-link" asp-action="Edit" asp-route-id="@supplier.SupplierCode">Edit</a><form asp-action="Delete" asp-route-id="@supplier.SupplierCode" method="post" class="inline-form" onsubmit="return confirm('Delete this supplier and related purchase records?');"><button class="danger-link" type="submit">Delete</button></form> }</td></tr> }
</tbody></table></div>@if (Model.Suppliers.Count == 0) { <div class="empty-state compact"><p>No suppliers match this search.</p></div> }</section>