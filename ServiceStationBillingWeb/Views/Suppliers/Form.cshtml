@model ServiceStationBillingWeb.Models.SupplierFormViewModel
@{ var editing = !string.IsNullOrWhiteSpace(Model.OriginalSupplierCode); ViewData["Title"] = editing ? "Edit supplier" : "Add supplier"; }
<div class="page-heading"><div><p class="eyebrow">Supplier records</p><h1>@ViewData["Title"]</h1></div></div>
<section class="form-section"><form asp-action="@(editing ? "Edit" : "Create")" method="post" class="form-grid"><input asp-for="OriginalSupplierCode" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="SupplierCode"></label><input asp-for="SupplierCode" autofocus /><span asp-validation-for="SupplierCode" class="validation"></span></div><div class="field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span></div><div class="field"><label asp-for="Contact"></label><input asp-for="Contact" /><span asp-validation-for="Contact" class="validation"></span></div><div class="field"><label asp-for="Invoice"></label><input asp-for="Invoice" /><span asp-validation-for="Invoice" class="validation"></span></div><div class="form-actions"><button class="button button-primary" type="submit">Save supplier</button><a class="button button-quiet" asp-action="Index">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }