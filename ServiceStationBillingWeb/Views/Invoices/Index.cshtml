@model ServiceStationBillingWeb.Models.InvoiceListViewModel
@{
    ViewData["Title"] = "Invoices";
}
<div class="page-heading"><div><p class="eyebrow">Billing records</p><h1>Invoices</h1></div><a class="button button-primary" asp-controller="Billing" asp-action="Create">New invoice</a></div>
@if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
<form method="get" class="toolbar"><input type="date" name="from" value="@Model.From" aria-label="From date" /><input type="date" name="to" value="@Model.To" aria-label="To date" /><input name="search" value="@Model.Search" placeholder="Search bill or customer" aria-label="Search invoices" /><select name="paymentMethod" aria-label="Payment method"><option value="">All methods</option><option selected="@(Model.PaymentMethod == "Cash")">Cash</option><option selected="@(Model.PaymentMethod == "Cheque")">Cheque</option><option selected="@(Model.PaymentMethod == "Credit")">Credit</option></select><button class="button button-secondary" type="submit">Filter</button><a class="button button-quiet" asp-action="Index">Clear</a></form>
<div class="metric-grid"><article class="metric-card"><span>Filtered total</span><strong>@Model.FilteredTotal.ToString("N2")</strong></article><article class="metric-card"><span>Cash</span><strong>@Model.CashTotal.ToString("N2")</strong></article><article class="metric-card"><span>Cheque</span><strong>@Model.ChequeTotal.ToString("N2")</strong></article><article class="metric-card accent"><span>Credit</span><strong>@Model.CreditTotal.ToString("N2")</strong></article></div>
<div class="section-heading"><h2>@(Model.CreditorsOnly ? "Open creditors" : "Invoice history")</h2><a class="button button-secondary" asp-action="Index" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-creditorsOnly="true">Creditors view</a></div>
<form asp-action="Settle" method="post"><input type="hidden" name="from" value="@Model.From" /><input type="hidden" name="to" value="@Model.To" /><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="paymentMethod" value="@Model.PaymentMethod" /><input type="hidden" name="creditorsOnly" value="@Model.CreditorsOnly" /><section class="content-section"><div class="table-wrap"><table><thead><tr><th>Select</th><th>Bill</th><th>Customer</th><th>Vehicle</th><th>Date</th><th>Method</th><th>Status</th><th class="number">Amount</th></tr></thead><tbody>
@foreach (var invoice in Model.Invoices) { <tr><td><input type="checkbox" name="selectedIds" value="@invoice.Id" @(invoice.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase) ? "disabled" : null) /></td><td class="strong"><a asp-action="Details" asp-route-id="@invoice.Id">@invoice.BillNo</a></td><td>@invoice.CustomerName</td><td>@invoice.VehicleNo</td><td>@invoice.DateTime</td><td>@invoice.PaymentMethod</td><td><span class="status">@invoice.PaymentStatus</span></td><td class="number">@invoice.TotalAmount.ToString("N2")</td></tr> }
</tbody></table></div>@if (Model.Invoices.Count == 0) { <div class="empty-state compact"><p>No invoices match these filters.</p></div> } @if (Model.Invoices.Any(i => i.PaymentMethod.Equals("Credit", StringComparison.OrdinalIgnoreCase) && !i.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))) { <button class="button button-primary" type="submit">Mark selected credit invoices settled</button> }</section></form>