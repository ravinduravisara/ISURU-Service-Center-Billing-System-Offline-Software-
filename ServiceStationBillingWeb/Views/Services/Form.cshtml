@model ServiceStationBillingWeb.Models.ServiceFormViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Edit service" : "Add service";
}
<div class="page-heading"><div><p class="eyebrow">Service records</p><h1>@ViewData["Title"]</h1></div></div>
<section class="form-section"><form asp-action="@(editing ? "Edit" : "Create")" method="post" class="form-grid"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="Category"></label><input asp-for="Category" autofocus /><span asp-validation-for="Category" class="validation"></span></div><div class="field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span></div><div class="field"><label asp-for="Price"></label><input asp-for="Price" type="number" min="0" step="0.01" /><span asp-validation-for="Price" class="validation"></span></div><div class="field"><label asp-for="Description"></label><input asp-for="Description" /><span asp-validation-for="Description" class="validation"></span></div><div class="form-actions"><button class="button button-primary" type="submit">Save service</button><a class="button button-quiet" asp-action="Index">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }